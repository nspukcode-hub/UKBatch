<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UKBatch.Api.Tests</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA1812;CA2007;CA1303;CA1305;CA1031;CA1849;CA1051;CA1062;CA1859;CA1848;CA1822;CS1591;CS1574;CS1573;CA2227;CA1819;CA1816;IDE0005;CA1052;CA1063;CA1064</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\UKBatch.Api\UKBatch.Api.csproj" />
    <ProjectReference Include="..\..\samples\Sample.RestApi\Sample.RestApi.csproj" />
    <!--
      Sample.RestApi.HubClient is intentionally NOT referenced: both Sample apps generate a
      synthetic `Program` class via top-level statements, and a dual-reference creates a CS0433
      ambiguity ("type 'Program' exists in both"). In-process hub smoke tests build
      HubConnection directly in the test class — see Hub/JobStatusHubTests.cs.
    -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
