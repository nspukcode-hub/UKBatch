<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UKBatch.AspNetCore.Tests</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA1812;CA2007;CA1303;CA1305;CA1031;CA1849;CA1051;CA1062;CA1859;CA1848;CA1822;CS1591;CS1574;CS1573;CA2227;CA1819;CA1816;IDE0005;CA1052;CA1707;CA1063;CA1064</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
