<Project>

  <PropertyGroup Label="Core build">
    <!-- Multi-target is the default: every shipped package (and its test/sample dependents)
         builds for both net10.0 and net8.0. net10-only hosts (UKBatch.Server, Docker-only
         samples) opt out with <TargetFrameworks>net10.0</TargetFrameworks> in their own csproj.
         net10.0 is listed first so it stays the IDE / `dotnet run` default. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet metadata" Condition="'$(IsPackable)' == 'true' OR ('$(IsPackable)' == '' AND $(MSBuildProjectName.StartsWith('UKBatch')) AND !$(MSBuildProjectName.EndsWith('.Tests')) AND $(MSBuildProjectName) != 'UKBatch.Server')">
    <IsPackable>true</IsPackable>
    <Authors>Ugur Kaykusuz</Authors>
    <Company>UKBatch</Company>
    <Copyright>Copyright (c) Ugur Kaykusuz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nspukcode-hub/UKBatch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nspukcode-hub/UKBatch.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>batch;job;orchestration;workflow;background-jobs;blazor;dashboard;microservices;batch-processing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/nspukcode-hub/UKBatch/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>0.2.4</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>

  <!-- Targeted NuGet audit suppression. CVE-2025-6965 (memory corruption in SQLite < 3.50.2) reaches the
       build only transitively, via Microsoft.EntityFrameworkCore.Sqlite → SQLitePCLRaw.lib.e_sqlite3. No
       patched version exists yet — every released version (<= 2.1.11, which is the latest) is flagged, so
       there is nothing to bump to. The library runs no untrusted SQL: EF Core generates every query from a
       fixed schema and no operator or end-user SQL is accepted, so the malicious-aggregate trigger is not
       reachable. Remove this suppression once EF Core Sqlite ships a SQLitePCLRaw built on SQLite 3.50.2+. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- Targeted NuGet audit suppression. GHSA-pgww-w46g-26qg / CVE-2026-54570 (mutated XSS in AngleSharp
       < 1.5.0) reaches the build only transitively, via bunit 1.34 → AngleSharp 1.1.2. The advisory is
       patched in 1.5.0, but AngleSharp 1.5.x changed the IHtmlCollection indexer that bunit 1.34 calls
       (FindAll()[i]), so pinning forward makes bunit throw MissingMethodException at test time — the fix
       is not consumable until bunit ships an AngleSharp-1.5-compatible release. The vulnerability is an
       mXSS re-parsing bug in untrusted HTML; the only consumer here is bunit's DOM assertions over the
       dashboard's own trusted rendered markup (test-only, never shipped), so the trigger is not
       reachable. Remove this suppression and pin AngleSharp forward once bunit is compatible with 1.5+. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
