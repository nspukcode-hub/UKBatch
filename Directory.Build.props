<Project>

  <PropertyGroup Label="Core build">
    <!-- Multi-target is the default: every shipped package (and its test/sample dependents)
         builds for both net10.0 and net8.0. net10-only hosts (UKBatch.Server, Docker-only
         samples) opt out with <TargetFrameworks>net10.0</TargetFrameworks> in their own csproj.
         net10.0 is listed first so it stays the IDE / `dotnet run` default. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet metadata" Condition="'$(IsPackable)' == 'true' OR ('$(IsPackable)' == '' AND $(MSBuildProjectName.StartsWith('UKBatch')) AND !$(MSBuildProjectName.EndsWith('.Tests')) AND $(MSBuildProjectName) != 'UKBatch.Server')">
    <IsPackable>true</IsPackable>
    <Authors>Ugur Kaykusuz</Authors>
    <Company>UKBatch</Company>
    <Copyright>Copyright (c) Ugur Kaykusuz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nspukcode-hub/UKBatch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nspukcode-hub/UKBatch.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>batch;job;orchestration;workflow;background-jobs;blazor;dashboard;microservices;batch-processing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/nspukcode-hub/UKBatch/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>0.1.2</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
