{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UKBatch": {
    // Provider/toggle defaults (Storage:Provider=inmemory, Transport:Provider=inprocess,
    // EnableDashboard=true, ThisServiceName=ukbatch-server) are applied in Program.cs so the flat
    // UKBATCH_* env vars (compose / Dockerfile) can override cleanly — leaving them here would shadow
    // the env override. Override via UKBATCH_STORAGE / UKBATCH_TRANSPORT / UKBATCH_ENABLE_DASHBOARD /
    // UKBATCH_SERVICE_NAME, or the structured UKBatch:* keys.
    "Dashboard": {
      "SelfBaseUrl": "http://localhost:8080/api/"
    }
  }
}
