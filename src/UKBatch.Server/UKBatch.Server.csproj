<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Explicit (Directory.Build.props ALSO excludes UKBatch.Server from the pack heuristic by
         name) — the server is a deployable Docker app, not a NuGet package. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>UKBatch.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Razor Components framework assets (blazor.web.js + blazor.server.js + fingerprinted
         variants) only enter the static-web-assets manifest when the host project is detected
         as a Razor host. The Web SDK auto-detects via `.razor` Content items
         (Microsoft.NET.Sdk.Web.ProjectSystem.targets:32). UKBatch.Server hosts UKBatch.Dashboard's
         App.razor by type reference (`MapUKBatchDashboard()` → `MapRazorComponents<App>()`), not by
         owning any .razor file, so the auto-detection misses. The `build/UKBatch.Dashboard.props`
         opt-in does NOT flow across a ProjectReference (NuGet build/*.props travel via PackageReference
         only). Setting RequiresAspNetWebAssets explicitly is the SDK's supported
         escape hatch — see Microsoft.NET.Sdk.FrameworkReferenceResolution.targets:21 for the
         default-false fallback. Mirrors Sample.Dashboard.csproj:16. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UKBatch.AspNetCore\UKBatch.AspNetCore.csproj" />
    <ProjectReference Include="..\UKBatch.Api\UKBatch.Api.csproj" />
    <ProjectReference Include="..\UKBatch.Dashboard\UKBatch.Dashboard.csproj" />
    <ProjectReference Include="..\UKBatch.Storage.EntityFrameworkCore\UKBatch.Storage.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\UKBatch.Transport.Http\UKBatch.Transport.Http.csproj" />
    <ProjectReference Include="..\UKBatch.Transport.RabbitMQ\UKBatch.Transport.RabbitMQ.csproj" />
  </ItemGroup>
</Project>
