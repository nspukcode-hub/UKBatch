@* Root layout. Sidebar + header + content + connection banner + toasts. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject IUKBatchServiceRegistry Registry
@inject IDashboardState State

<div class="dashboard-shell">
    <ServiceSidebar Services="@Registry.All()" CurrentService="@State.CurrentService" />
    <div class="dashboard-main">
        <header class="dashboard-header">
            <div class="dashboard-header__breadcrumb">
                @if (State.CurrentService is { } svc)
                {
                    <span class="dashboard-header__breadcrumb-service">@(svc.DisplayName ?? svc.Name)</span>
                }
                else
                {
                    <span class="dashboard-header__breadcrumb-service">UKBatch</span>
                }
                <span class="dashboard-header__breadcrumb-sep">/</span>
                <span class="dashboard-header__breadcrumb-current">Dashboard</span>
            </div>
            <div class="dashboard-header__actions">
                <a class="btn btn--icon" href="/dashboard/settings" title="Settings" aria-label="Settings">
                    <span class="material-symbols-outlined">settings</span>
                </a>
                <a class="btn btn--icon" href="/dashboard" title="Home" aria-label="Home">
                    <span class="material-symbols-outlined">home</span>
                </a>
            </div>
        </header>
        @if (State.CurrentService is { } currentSvc)
        {
            <ConnectionBanner CurrentService="@currentSvc" />
        }
        <main class="dashboard-content">
            @Body
        </main>
        <ToastContainer />
    </div>
</div>

@code {
    // The theme initial bootstrap moved to App.razor <head> inline script
    // so the user's preferred theme is applied BEFORE first paint. The theme TOGGLE handler
    // lives on Settings.razor (page-scoped @inject IJSRuntime). The layout itself stays free
    // of JS interop — it only consumes the registry + state.

    protected override void OnInitialized()
    {
        // The header breadcrumb + the sidebar/banner both read State.CurrentService from THIS layout.
        // Subscribe so a page swapping the current service (or Settings clearing it to null) repaints
        // the shell immediately, instead of lagging one navigation behind.
        State.CurrentServiceChanged += OnCurrentServiceChanged;
    }

    private void OnCurrentServiceChanged(UKBatchServiceDescriptor? service)
    {
        // The event is raised synchronously from the circuit thread; InvokeAsync is still the correct,
        // safe way to schedule the re-render on the render dispatcher. Fire-and-forget is fine here —
        // there is no continuation to await.
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Unsubscribe so a torn-down circuit can't receive a late callback that calls StateHasChanged
        // on a disposed component.
        State.CurrentServiceChanged -= OnCurrentServiceChanged;
    }
}
