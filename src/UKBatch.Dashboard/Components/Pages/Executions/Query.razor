@* Executions query — filter form + paginated results + optional tail mode. *@
@page "/dashboard/{ServiceName}/executions"
@implements IAsyncDisposable
@inject IUKBatchServiceRegistry Registry
@inject IUKBatchClientFactory ClientFactory
@inject IDashboardState State
@inject NavigationManager Nav

<PageTitle>Executions - @ServiceName - UKBatch</PageTitle>

@if (_redirected) return;

<h1 class="page-title">Executions</h1>

<section class="surface-card">
    <div class="surface-card__header">
        <h2 class="surface-card__title">Filter</h2>
        <div class="executions-header__controls">
            @* Executions (one row per execution) ↔ Runs (one row per batch run). Defaults to Executions
               so existing deep links and habits are unchanged; the Runs view is opt-in. *@
            <div class="dag-toolbar__group">
                <button class="dag-toolbar__btn @(_runsMode ? null : "dag-toolbar__btn--active")" @onclick="@(() => SwitchModeAsync(false))">Executions</button>
                <button class="dag-toolbar__btn @(_runsMode ? "dag-toolbar__btn--active" : null)" @onclick="@(() => SwitchModeAsync(true))">Runs</button>
            </div>
            @if (!_runsMode)
            {
                <label class="tail-mode-toggle">
                    <input type="checkbox" @bind="_tailMode" @bind:after="OnTailToggledAsync" />
                    <span>Tail mode (live)</span>
                </label>
            }
        </div>
    </div>
    <div class="surface-card__body">
        <div class="form-row">
            @* Job name / batch-run-id / search apply to executions only — hidden in Runs mode. The batch
               DEFINITION id filters runs too, so it stays visible in both modes. *@
            @if (!_runsMode)
            {
                <div class="form-field">
                    <label class="form-field__label" for="job-name">Job name</label>
                    <input id="job-name" class="form-field__input" type="text" @bind="_jobNameFilter" />
                </div>
                <div class="form-field">
                    <label class="form-field__label" for="batch-id">Batch run id</label>
                    <input id="batch-id" class="form-field__input" type="text" @bind="_batchIdFilter" />
                </div>
            }
            <div class="form-field">
                <label class="form-field__label" for="batch-def-id">Batch definition id</label>
                <input id="batch-def-id" class="form-field__input" type="text" @bind="_batchDefIdFilter" />
            </div>
            @if (!_runsMode)
            {
                <div class="form-field">
                    <label class="form-field__label" for="search-text">Search text</label>
                    <input id="search-text" class="form-field__input" type="search" @bind="_searchTextFilter" />
                </div>
            }
        </div>
        <div class="form-row" style="margin-top: var(--space-md);">
            <button class="btn btn--primary" @onclick="ReloadAsync">
                <span class="material-symbols-outlined">search</span>
                Apply filter
            </button>
            <button class="btn btn--ghost" @onclick="ClearAsync">Clear</button>
        </div>
    </div>
</section>

@if (_errorMessage is { } err)
{
    <ErrorBanner Message="@err" OnRetry="ReloadAsync" />
}
else if (_runsMode)
{
    @if (_runsEnvelope is null)
    {
        <div class="page-loader">
            <span class="material-symbols-outlined spin-animation">progress_activity</span>
            <span>Loading runs…</span>
        </div>
    }
    else if (_runsEnvelope.Items.Count == 0)
    {
        <EmptyState Title="No runs match" Detail="Adjust the definition filter or trigger a batch." IconName="search_off" />
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th class="data-table__header">Run</th>
                    <th class="data-table__header">Status</th>
                    <th class="data-table__header">Definition</th>
                    <th class="data-table__header">Started</th>
                    <th class="data-table__header">Duration</th>
                    <th class="data-table__header">Total</th>
                    <th class="data-table__header">Succeeded</th>
                    <th class="data-table__header">Failed</th>
                    <th class="data-table__header">Cancelled</th>
                    <th class="data-table__header">Steps</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in _runsEnvelope.Items)
                {
                    <tr @key="run.BatchId" class="data-table__row">
                        <td class="data-table__cell data-table__cell--id">
                            <a href="/dashboard/@ServiceName/runs/@run.BatchId">@IdDisplay.Shorten(run.BatchId)</a>
                        </td>
                        <td class="data-table__cell data-table__cell--status"><JobStatusBadge Status="@(run.Status ?? JobStatus.Running)" /></td>
                        <td class="data-table__cell">@run.BatchName</td>
                        <td class="data-table__cell data-table__cell--id">@run.StartedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="data-table__cell data-table__cell--id">@FormatDuration(RunDuration(run))</td>
                        <td class="data-table__cell">@run.Total</td>
                        <td class="data-table__cell">@run.Succeeded</td>
                        <td class="data-table__cell">@run.Failed</td>
                        <td class="data-table__cell">@run.Cancelled</td>
                        <td class="data-table__cell">@run.StepCount</td>
                    </tr>
                }
            </tbody>
        </table>
        <PageEnvelopePager Envelope="@_runsEnvelope" Limit="@_limit" OnOffsetChanged="OnOffsetChanged" T="BatchRun" />
    }
}
else if (_envelope is null)
{
    <div class="page-loader">
        <span class="material-symbols-outlined spin-animation">progress_activity</span>
        <span>Loading executions…</span>
    </div>
}
else if (_envelope.Items.Count == 0)
{
    <EmptyState Title="No executions match" Detail="Adjust filters or trigger a job." IconName="search_off" />
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th class="data-table__header">ID</th>
                <th class="data-table__header">Job</th>
                <th class="data-table__header">Status</th>
                <th class="data-table__header">Progress</th>
                <th class="data-table__header">Enqueued</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _displayed)
            {
                <LiveExecutionRow @key="row.ExecutionId"
                                  ServiceName="@ServiceName"
                                  InitialModel="@row"
                                  SubscribeToLive="false" />
            }
        </tbody>
    </table>
    @if (!_tailMode)
    {
        <PageEnvelopePager Envelope="@_envelope" Limit="@_limit" OnOffsetChanged="OnOffsetChanged" T="JobExecution" />
    }
}

@code {
    [Parameter] public string ServiceName { get; set; } = default!;

    // Deep link from a batch run page (Batches/RunDetail "View in Executions"): pre-fills the
    // batch-run-id filter so the first query is already scoped to that run.
    [Parameter, SupplyParameterFromQuery(Name = "batchId")] public string? BatchIdQuery { get; set; }

    // Deep link from a job detail page (Jobs/Detail "View all in Executions"): pre-fills the
    // job-name filter so the first query is already scoped to that job.
    [Parameter, SupplyParameterFromQuery(Name = "jobName")] public string? JobNameQuery { get; set; }

    private IUKBatchClient? _client;
    private PageEnvelope<JobExecution>? _envelope;
    private List<ExecutionRowViewModel> _displayed = new();
    private PageEnvelope<BatchRun>? _runsEnvelope;   // populated only in Runs mode
    private int _offset;
    private int _limit = 50;
    private string? _jobNameFilter;
    private string? _batchIdFilter;
    private string? _batchDefIdFilter;
    private string? _searchTextFilter;
    private string? _errorMessage;
    private bool _tailMode;
    private bool _allSubscribed;
    private bool _redirected;
    private bool _runsMode;   // false = Executions (one row per execution), true = Runs (one row per batch run)

    private JobQueryRequest BuildQuery() => new()
    {
        JobName = string.IsNullOrWhiteSpace(_jobNameFilter) ? null : _jobNameFilter,
        BatchId = string.IsNullOrWhiteSpace(_batchIdFilter) ? null : _batchIdFilter,
        BatchDefinitionId = string.IsNullOrWhiteSpace(_batchDefIdFilter) ? null : _batchDefIdFilter,
        SearchText = string.IsNullOrWhiteSpace(_searchTextFilter) ? null : _searchTextFilter,
        Offset = _offset,
        Limit = _limit,
    };

    protected override async Task OnInitializedAsync()
    {
        var descriptor = Registry.TryGet(ServiceName);
        if (descriptor is null)
        {
            _redirected = true;
            Nav.NavigateTo("/dashboard", replace: true);
            return;
        }
        State.CurrentService = descriptor;
        _client = ClientFactory.GetClient(ServiceName);

        // Apply the deep-link filters BEFORE the first query so the initial results are already scoped.
        if (!string.IsNullOrWhiteSpace(BatchIdQuery))
            _batchIdFilter = BatchIdQuery;
        if (!string.IsNullOrWhiteSpace(JobNameQuery))
            _jobNameFilter = JobNameQuery;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_client is null) return;
        _errorMessage = null;
        try
        {
            if (_runsMode)
            {
                // Runs view: the batch DEFINITION id is the only meaningful run filter (job name / search
                // are execution-scoped). includeRunning=true so in-progress runs (Status null) show too.
                var defId = string.IsNullOrWhiteSpace(_batchDefIdFilter) ? null : _batchDefIdFilter;
                _runsEnvelope = await _client.QueryRunsAsync(defId, includeRunning: true, _offset, _limit, CancellationToken.None);
            }
            else
            {
                _envelope = await _client.QueryExecutionsAsync(BuildQuery(), CancellationToken.None);
                _displayed = _envelope.Items.Select(ExecutionRowViewModel.FromExecution).ToList();
            }
        }
        catch (UKBatchClientException ex)
        {
            _errorMessage = $"Query failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unexpected failure: {ex.Message}";
        }
    }

    // Toggles between the Executions and Runs views. Resets paging and (when entering Runs) disengages tail
    // mode — tailing is an execution-only live stream. Then reloads against the newly-selected source.
    private async Task SwitchModeAsync(bool runs)
    {
        if (_runsMode == runs) return;
        _runsMode = runs;
        _offset = 0;
        if (runs && _tailMode)
        {
            // Leave the live execution subscription before switching away from the executions table.
            _tailMode = false;
            await OnTailToggledAsync();
        }
        await ReloadAsync();
    }

    private async Task ClearAsync()
    {
        _offset = 0;
        _jobNameFilter = null;
        _batchIdFilter = null;
        _batchDefIdFilter = null;
        _searchTextFilter = null;
        await ReloadAsync();
    }

    // Duration of a finished run, or null while in progress. Computed straight off the run record so the Runs
    // table needs no extra view model.
    private static TimeSpan? RunDuration(BatchRun run)
        => run.CompletedAtUtc is { } end ? end - run.StartedAtUtc : null;

    // Terse duration label shared by the runs table. A running run (null) reads as an em-dash. Numbers are
    // formatted with the invariant culture so a comma-decimal locale doesn't render "1,5 s".
    private static string FormatDuration(TimeSpan? d)
    {
        if (d is not { } span) return "—";
        var c = System.Globalization.CultureInfo.InvariantCulture;
        if (span < TimeSpan.FromSeconds(1)) return span.TotalMilliseconds.ToString("F0", c) + " ms";
        if (span < TimeSpan.FromMinutes(1)) return span.TotalSeconds.ToString("F1", c) + " s";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{(int)span.TotalHours}h {span.Minutes}m";
    }

    private async Task OnOffsetChanged(int newOffset)
    {
        _offset = newOffset;
        await ReloadAsync();
    }

    private async Task OnTailToggledAsync()
    {
        if (_client is null) return;
        if (_tailMode && !_allSubscribed)
        {
            _client.ExecutionStateChanged += OnExecutionStateChangedAsync;
            try { await _client.SubscribeAllAsync(CancellationToken.None); _allSubscribed = true; }
            catch (Exception) { _tailMode = false; }
        }
        else if (!_tailMode && _allSubscribed)
        {
            _client.ExecutionStateChanged -= OnExecutionStateChangedAsync;
            try { await _client.UnsubscribeAllAsync(CancellationToken.None); }
            catch (Exception) { /* ignore */ }
            _allSubscribed = false;
        }
    }

    private async Task OnExecutionStateChangedAsync(JobExecution exec)
    {
        if (!_tailMode) return;
        var idx = _displayed.FindIndex(r => r.ExecutionId == exec.ExecutionId);
        if (idx >= 0)
        {
            _displayed[idx] = ExecutionRowViewModel.FromExecution(exec);
        }
        else
        {
            _displayed.Insert(0, ExecutionRowViewModel.FromExecution(exec));
            if (_displayed.Count > 200) _displayed = _displayed.Take(200).ToList();
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_client is not null && _allSubscribed)
        {
            _client.ExecutionStateChanged -= OnExecutionStateChangedAsync;
            try { await _client.UnsubscribeAllAsync(CancellationToken.None); }
            catch (Exception) { /* ignore */ }
        }
    }
}

<style>
    .executions-header__controls { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }
    .tail-mode-toggle { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-text-secondary); cursor: pointer; }
</style>
