@* CANONICAL LIVE PAGE — single execution + progress + monotonic Status guard +
   subscribe-first-then-fetch + cancel action. *@
@page "/dashboard/{ServiceName}/executions/{Id}"
@implements IAsyncDisposable
@inject IUKBatchServiceRegistry Registry
@inject IUKBatchClientFactory ClientFactory
@inject IDashboardState State
@inject INotificationService Notifications
@inject NavigationManager Nav

<PageTitle>Execution @IdDisplay.Shorten(Id) - UKBatch</PageTitle>

@if (_redirected) return;

@if (_isLoading)
{
    <div class="page-loader">
        <span class="material-symbols-outlined spin-animation">progress_activity</span>
        <span>Loading execution…</span>
    </div>
}
else if (_errorMessage is { } err)
{
    <ErrorBanner Message="@err" />
}
else if (_execution is null)
{
    <EmptyState Title="Execution not found"
                Detail="@($"Execution '{Id}' was not found on '{ServiceName}'.")"
                IconName="search_off">
        <ActionContent>
            <a class="btn btn--primary" href="/dashboard/@ServiceName/executions">Back to query</a>
        </ActionContent>
    </EmptyState>
}
else
{
    <div class="execution-detail__header">
        <h1 class="page-title">Execution <span class="mono">@IdDisplay.Shorten(Id)</span></h1>
        <div class="execution-detail__actions">
            <JobStatusBadge Status="@_execution.Status" />
            @if (CanCancel())
            {
                <button class="btn btn--danger" @onclick="@(() => _confirmCancelOpen = true)" disabled="@_cancelInFlight">
                    <span class="material-symbols-outlined">cancel</span>
                    Cancel
                </button>
            }
        </div>
    </div>

    <section class="surface-card">
        <div class="surface-card__header">
            <h2 class="surface-card__title">Snapshot</h2>
        </div>
        <div class="surface-card__body">
            <dl class="execution-detail__grid">
                @* Full execution id — the page title abbreviates it, but the Executions filters match exact ids. *@
                <dt>Id</dt><dd><CopyableId Value="@Id" /></dd>
                <dt>Job</dt><dd>@_execution.JobName</dd>
                @if (_execution.BatchId is { } bid)
                {
                    <dt>Batch run</dt><dd class="mono"><a href="/dashboard/@ServiceName/runs/@bid">@IdDisplay.Shorten(bid)</a></dd>
                }
                @if (_execution.BatchDefinitionId is { } bdid)
                {
                    <dt>Batch definition</dt><dd class="mono"><a href="/dashboard/@ServiceName/batches/@bdid">@IdDisplay.Shorten(bdid)</a></dd>
                }
                <dt>Attempt</dt><dd>@_execution.AttemptNumber / @(_execution.MaxRetries + 1)</dd>
                <dt>Enqueued</dt><dd class="mono">@_execution.EnqueuedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                @if (_execution.StartedAtUtc is { } start)
                {
                    <dt>Started</dt><dd class="mono">@start.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                }
                @if (_execution.CompletedAtUtc is { } done)
                {
                    <dt>Completed</dt><dd class="mono">@done.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                }
                @if (_execution.WorkerName is { } worker)
                {
                    <dt>Worker</dt><dd>@worker</dd>
                }
                @if (_execution.TriggeredBy is { } trg)
                {
                    <dt>Triggered by</dt><dd>@trg</dd>
                }
            </dl>
        </div>
    </section>

    @if (_execution.Total is not null || _execution.Processed > 0 || _execution.Failed > 0)
    {
        <section class="surface-card">
            <div class="surface-card__header">
                <h2 class="surface-card__title">Progress</h2>
            </div>
            <div class="surface-card__body">
                <ProgressBar Processed="_execution.Processed" Failed="_execution.Failed" Total="_execution.Total" />
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(_execution.LastError))
    {
        <section class="surface-card surface-card--error">
            <div class="surface-card__header">
                <h2 class="surface-card__title">Last error</h2>
            </div>
            <div class="surface-card__body">
                <pre class="execution-detail__error">@_execution.LastError</pre>
            </div>
        </section>
    }
}

<ConfirmDialog IsVisible="@_confirmCancelOpen"
               Title="Cancel execution?"
               ConfirmLabel="Cancel execution"
               CancelLabel="Keep running"
               IsDestructive="true"
               OnConfirm="ConfirmCancelAsync"
               OnCancel="() => { _confirmCancelOpen = false; return Task.CompletedTask; }">
    <Body>
        <p>This will request cancellation of execution <span class="mono">@IdDisplay.Shorten(Id)</span>.
           The worker may still complete the in-flight item before honoring the cancel.</p>
    </Body>
</ConfirmDialog>

@code {
    [Parameter] public string ServiceName { get; set; } = default!;
    [Parameter] public string Id { get; set; } = default!;

    private IUKBatchClient? _client;
    private JobExecution? _execution;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _redirected;
    private bool _subscribed;
    private bool _confirmCancelOpen;
    private bool _cancelInFlight;

    @* Monotonic Status rank guard via JobStatusRank.Rank. *@

    protected override async Task OnInitializedAsync()
    {
        var descriptor = Registry.TryGet(ServiceName);
        if (descriptor is null)
        {
            _redirected = true;
            Nav.NavigateTo("/dashboard", replace: true);
            return;
        }
        State.CurrentService = descriptor;

        try
        {
            _client = ClientFactory.GetClient(ServiceName);

            // Subscribe FIRST, fetch SECOND — events raised during the fetch are not lost.
            _client.ExecutionStateChanged += OnExecutionStateChangedAsync;
            _client.ProgressUpdated += OnProgressUpdatedAsync;
            try
            {
                await _client.SubscribeToExecutionAsync(Id, CancellationToken.None);
                _subscribed = true;
            }
            catch (Exception)
            {
                // Subscribe failure non-fatal — page renders snapshot only.
            }

            _execution = await _client.GetExecutionAsync(Id, CancellationToken.None);
        }
        catch (UKBatchClientException ex)
        {
            _errorMessage = $"Failed to load execution: {ex.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unexpected failure: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnExecutionStateChangedAsync(JobExecution exec)
    {
        if (exec.ExecutionId != Id) return;

        @* B1 monotonic guard. *@
        if (_execution is not null && JobStatusRank.Rank(exec.Status) < JobStatusRank.Rank(_execution.Status)) return;
        if (_execution is not null && exec.Status == _execution.Status && exec.AttemptNumber < _execution.AttemptNumber) return;

        _execution = exec;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnProgressUpdatedAsync(ProgressBeat beat)
    {
        if (beat.ExecutionId != Id || _execution is null) return;
        _execution = _execution with { Processed = beat.Processed, Failed = beat.Failed, Total = beat.Total };
        await InvokeAsync(StateHasChanged);
    }

    private bool CanCancel()
        => _execution is not null
            && _execution.Status is JobStatus.Pending or JobStatus.Running or JobStatus.AwaitingApproval or JobStatus.Retrying;

    private async Task ConfirmCancelAsync()
    {
        _confirmCancelOpen = false;
        if (_client is null || _execution is null || _cancelInFlight) return;
        _cancelInFlight = true;
        try
        {
            await _client.CancelExecutionAsync(Id, CancellationToken.None);
            await Notifications.SuccessAsync("Cancellation requested", "The worker will honor the cancel signal on the next checkpoint.");
        }
        catch (UKBatchClientException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            await Notifications.InfoAsync("Already terminal", "Nothing to cancel — execution is already in a terminal state.");
        }
        catch (UKBatchClientException ex)
        {
            await Notifications.ErrorAsync("Cancel failed", ex.Message);
        }
        catch (Exception ex)
        {
            await Notifications.ErrorAsync("Unexpected failure", ex.Message);
        }
        finally
        {
            _cancelInFlight = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_client is not null)
        {
            _client.ExecutionStateChanged -= OnExecutionStateChangedAsync;
            _client.ProgressUpdated -= OnProgressUpdatedAsync;
            if (_subscribed)
            {
                try { await _client.UnsubscribeFromExecutionAsync(Id, CancellationToken.None); }
                catch (Exception) { /* ignore */ }
            }
        }
    }
}

<style>
    .execution-detail__header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-md); }
    .execution-detail__actions { display: flex; align-items: center; gap: var(--space-sm); }
    .execution-detail__grid { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-xs) var(--space-md); margin: 0; }
    .execution-detail__grid dt { color: var(--color-text-tertiary); font-size: var(--font-label-md-size); text-transform: uppercase; letter-spacing: var(--font-label-md-tracking); }
    .execution-detail__grid dd { margin: 0; color: var(--color-text-primary); }
    .execution-detail__error { white-space: pre-wrap; font-family: var(--font-mono); color: var(--color-status-failed); background: color-mix(in srgb, var(--color-status-failed) 8%, transparent); padding: var(--space-sm); border-radius: var(--radius-lg); margin: 0; }
    .surface-card--error { border-color: var(--color-status-failed); }
</style>
