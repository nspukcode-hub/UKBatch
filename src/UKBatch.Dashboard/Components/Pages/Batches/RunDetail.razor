@* Batch RUN detail — live executions + live DAG + BatchCompleted summary. *@
@page "/dashboard/{ServiceName}/runs/{BatchRunId}"
@using UKBatch.Dashboard.Models.DagStatus
@implements IAsyncDisposable
@inject IUKBatchServiceRegistry Registry
@inject IUKBatchClientFactory ClientFactory
@inject IDashboardState State
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<DashboardOptions> Options

<PageTitle>Batch run @IdDisplay.Shorten(BatchRunId) - UKBatch</PageTitle>

@if (_redirected) return;

<h1 class="page-title">Batch run <span class="mono">@IdDisplay.Shorten(BatchRunId)</span></h1>

@* Full run id, one click from the operator's clipboard — the page title abbreviates it (neighbouring
   runs share a prefix), but the Executions "Batch run id" filter is an exact match, so the whole id
   must be obtainable somewhere. The Cancel run CTA sits beside it while the run is still in flight. *@
<div class="batch-run__full-id">
    <CopyableId Value="@BatchRunId" Label="Run id" />
    @* Administrative cancel — only while the run hasn't completed (no BatchCompleted yet). Unblocks a run
       parked on an approval gate nobody can decide; the live feed flips the page to Cancelled. *@
    @if (_completion is null && !_isLoading)
    {
        <button class="btn btn--danger btn--sm" @onclick="@(() => _confirmCancelOpen = true)" disabled="@_cancelInFlight">
            <span class="material-symbols-outlined">cancel</span>
            @(_cancelInFlight ? "Cancelling…" : "Cancel run")
        </button>
    }
</div>

@if (_cancelError is { } cancelErr)
{
    <ErrorBanner Message="@cancelErr" />
}

<ConfirmDialog IsVisible="@_confirmCancelOpen"
               Title="Cancel run?"
               ConfirmLabel="Cancel run"
               CancelLabel="Keep running"
               IsDestructive="true"
               OnConfirm="ConfirmCancelAsync"
               OnCancel="@(() => { _confirmCancelOpen = false; return Task.CompletedTask; })">
    <Body>
        <p>This requests cancellation of run <span class="mono">@IdDisplay.Shorten(BatchRunId)</span>.
           A run parked on an approval gate ends as <span class="mono">Cancelled</span>; a job already
           dispatched runs to its own completion. This cannot be undone.</p>
    </Body>
</ConfirmDialog>

@if (_completion is { } summary)
{
    <section class="surface-card batch-run__completion @(CompletionBgClass(summary.FinalStatus))">
        <div class="surface-card__header">
            <h2 class="surface-card__title">
                <JobStatusBadge Status="@summary.FinalStatus" />
                <span>@summary.BatchName @CompletionVerb(summary.FinalStatus)</span>
            </h2>
        </div>
        <div class="surface-card__body">
            <dl class="completion-grid">
                <div><dt>Total</dt><dd>@summary.TotalJobs</dd></div>
                <div><dt>Succeeded</dt><dd>@summary.SucceededJobs</dd></div>
                <div><dt>Failed</dt><dd>@summary.FailedJobs</dd></div>
                <div><dt>Cancelled</dt><dd>@summary.CancelledJobs</dd></div>
                <div><dt>Completed</dt><dd class="mono">@summary.CompletedAtUtc.ToString("HH:mm:ss") UTC</dd></div>
            </dl>
        </div>
    </section>
}

@if (_definition is not null)
{
    <section class="surface-card">
        <div class="surface-card__header">
            <h2 class="surface-card__title">Topology</h2>
        </div>
        <div class="surface-card__body">
            <div class="dag-layout">
                <div class="dag-layout__canvas">
                    <DagStatusCanvas Steps="@_definition.Steps"
                                     OnFailureSteps="@_definition.OnFailureSteps"
                                     StatusByStepId="@_statusByStepId"
                                     PendingStepIds="@_pendingByStepId.Keys"
                                     SelectedStepId="@_selectedStepId"
                                     OnNodeSelected="OnNodeSelectedAsync"
                                     OnApproveClicked="HandleApproveFromNodeAsync" />
                </div>
                @if (_selectedStep is not null)
                {
                    <DagNodeDetailPanel Step="@_selectedStep"
                                        Status="@SelectedStatus()"
                                        PendingApprovalId="@SelectedPendingApprovalId()"
                                        DecisionBusy="@_decisionBusy"
                                        DecisionError="@_decisionError"
                                        OnApprove="HandleApproveAsync"
                                        OnReject="HandleRejectAsync"
                                        OnClose="ClosePanel" />
                }
            </div>
        </div>
    </section>
}

@* The batch-initial parameters the run was triggered with (read-only). Renders nothing when the run had
   none. Per-step forwarding is shown on each execution's own detail (its Input parameters + Outputs), NOT
   as a run-level accumulator — a flattened last-writer-wins blob can't show which step produced or consumed
   what, so it is deliberately not rendered here. *@
<KeyValuePanel Title="Initial parameters" Items="@_forwardedInitialParameters" KeyHeader="Parameter" ValueHeader="Value" />

@if (_isLoading)
{
    <div class="page-loader">
        <span class="material-symbols-outlined spin-animation">progress_activity</span>
        <span>Loading executions…</span>
    </div>
}
else if (_executionRows.Count == 0 && _completion is null)
{
    @* Gate the empty-state on `_completion is null` so the completion banner (the separate
       @if block above) and the "Waiting…" empty-state are mutually exclusive. A batch that completed
       with zero surviving rows (e.g. cross-service-only, undercounted) shows the banner, not "Waiting". *@
    <EmptyState Title="Waiting for first execution…"
                Detail="@($"Batch run '{IdDisplay.Shorten(BatchRunId)}' hasn't dispatched any executions yet.")"
                IconName="hourglass_empty" />
}
else
{
    <section class="surface-card">
        <div class="surface-card__header batch-run__executions-header">
            <h2 class="surface-card__title">Executions (@_executionRows.Count)</h2>
            @* Always available — the table is a capped live window; the full, queryable list lives here. *@
            <a class="batch-run__view-all" href="@AllExecutionsHref()">View in Executions</a>
        </div>
        <div class="surface-card__body">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="data-table__header">ID</th>
                        <th class="data-table__header">Job</th>
                        <th class="data-table__header">Status</th>
                        <th class="data-table__header">Progress</th>
                        <th class="data-table__header">Enqueued</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in RenderedRows())
                    {
                        <LiveExecutionRow @key="row.ExecutionId"
                                          ServiceName="@ServiceName"
                                          InitialModel="@row"
                                          SubscribeToLive="false" />
                    }
                </tbody>
            </table>
            @if (_executionRows.Count > MaxRenderedRows)
            {
                @* The deep link now lives in the section header (always present) — don't render it twice. *@
                <p class="page-subtitle">Showing the @MaxRenderedRows most recent executions.</p>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string ServiceName { get; set; } = default!;
    [Parameter] public string BatchRunId { get; set; } = default!;

    // This section is a live activity window, not the full execution log: it renders the most recent
    // executions newest-first, capped to keep a busy run's table short and the circuit light. The complete,
    // queryable list lives on the Executions page (linked under the table once the cap is exceeded).
    private const int MaxRenderedRows = 50;

    private IUKBatchClient? _client;
    private List<ExecutionRowViewModel> _executionRows = new();
    private BatchCompletionSummary? _completion;
    private bool _isLoading = true;
    private bool _redirected;
    private bool _subscribed;

    // ── live DAG ──
    private BatchDefinitionDto? _definition;
    private bool _definitionLoaded;            // single-shot definition fetch guard
    private bool _definitionFetchFailed;       // bound retries when defId 404s persistently

    // ── run-scoped initial parameters (read-only) ──
    // The persisted run row carries the batch-initial parameters the run was triggered with, under a
    // reserved ukbatch.* key. It rides the same run-store list this page already has a client method for
    // (QueryRunsAsync, filtered by definition id), fetched once the definition id is known — there is no
    // single-run-by-id endpoint, so this is a best-effort lookup within the most recent page of runs.
    private IReadOnlyDictionary<string, object?>? _forwardedInitialParameters;
    private bool _runLoaded;                    // single-shot run fetch guard (matches the definition guard)
    private bool _runFetchFailed;              // bound retries so the 4× fan-out doesn't re-query on every event

    // Reserved keys under BatchRun.ForwardedState (see UKBatch.Core ForwardedStateKeys). Referenced as
    // literals here so the dashboard does not need friend access to the internal Core constants.
    private const string ForwardedInitialParametersKey = "ukbatch.initialParameters";
    private IReadOnlyDictionary<string, JobStatus> _statusByStepId =
        new Dictionary<string, JobStatus>(StringComparer.Ordinal);
    // Approval-gate live status: gates are NOT jobs (no JobExecution row), so their state comes from the
    // gate feed, not _executionRows. Each gate carries its OWN recorded outcome (pending → AwaitingApproval;
    // approved/auto-approved → Completed; any other terminal outcome → Failed), so the colour is read
    // directly from the gate rather than inferred from the batch roll-up. Merged into _statusByStepId by
    // RebuildStatusMap so the DAG node colours like any other.
    private readonly Dictionary<string, JobStatus> _gateStatus = new(StringComparer.Ordinal);
    // Actionable pending approvals for THIS run, keyed by BatchStepId — so the node inspector can decide the
    // gate in-place (needs Config + ApprovalId, which the gate-colouring feed does NOT carry). Rebuilt in
    // RefreshGatesAsync from the pending approvals list; its keys also drive the in-node Approve button.
    private Dictionary<string, PendingApprovalDto> _pendingByStepId = new(StringComparer.Ordinal);
    private string? _selectedStepId;
    private BatchStep? _selectedStep;
    private UiRefreshDebounce? _refresh;        // coalesces hub bursts into one StateHasChanged

    // ── inline approval decision state ──
    private bool _decisionBusy;                  // true while an approve/reject REST call is in flight
    private string? _decisionError;              // surfaced in the panel; cleared on selection change / close

    // ── administrative run-cancel state ──
    private bool _confirmCancelOpen;             // the "Cancel run?" confirm dialog
    private bool _cancelInFlight;                // true while the cancel REST call is in flight
    private string? _cancelError;                // surfaced in a banner if the cancel request itself fails

    protected override async Task OnInitializedAsync()
    {
        var descriptor = Registry.TryGet(ServiceName);
        if (descriptor is null)
        {
            _redirected = true;
            Nav.NavigateTo("/dashboard", replace: true);
            return;
        }
        State.CurrentService = descriptor;

        // The debounce fires on a thread-pool continuation — render callback MUST hop to the dispatcher.
        _refresh = new UiRefreshDebounce(() => InvokeAsync(StateHasChanged), Options.Value.UiRefreshDebounce);

        try
        {
            _client = ClientFactory.GetClient(ServiceName);

            // Subscribe FIRST before the initial fetch so no events are missed in between.
            _client.ExecutionStateChanged += OnExecutionStateChangedAsync;
            _client.BatchCompleted += OnBatchCompletedAsync;
            _client.ApprovalRequested += OnApprovalRequestedAsync;   // approval-gate node colouring
            try
            {
                await _client.SubscribeToBatchAsync(BatchRunId, CancellationToken.None);
                _subscribed = true;
            }
            catch (Exception)
            {
                // Subscribe failure non-fatal — REST snapshot still loads.
            }

            var page = await _client.GetBatchRunStatusAsync(BatchRunId, 0, 500, CancellationToken.None);
            _executionRows = page.Items.Select(ExecutionRowViewModel.FromExecution).ToList();
            RebuildStatusMap();
            await RefreshGatesAsync();   // catch a gate already pending on a page reload

            // Lazy-load the definition for the DAG topology if any execution already carries it.
            // Fresh runs have 0 executions at init — the event handler covers that case.
            var defId = page.Items.Select(i => i.BatchDefinitionId).FirstOrDefault(id => !string.IsNullOrEmpty(id));
            if (defId is { Length: > 0 })
            {
                await TryLoadDefinitionAsync(defId);
                await TryLoadRunAsync(defId);
            }
        }
        catch (UKBatchClientException)
        {
            // 404 is non-fatal — batch run may not exist yet (live subscription will populate).
        }
        catch (Exception)
        {
            // Surface via EmptyState — leave rows empty so UI shows "Waiting for first execution".
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnExecutionStateChangedAsync(JobExecution exec)
    {
        if (exec.BatchId != BatchRunId) return;

        // Lazy, single-shot definition fetch (fresh runs have 0 executions at init, so the
        // topology can only be resolved once the first row with a BatchDefinitionId arrives).
        // Gate on _definitionFetchFailed so a persistent 404 (definition deleted)
        // doesn't re-fetch on every event (the up-to-4× hub fan-out would otherwise spam it).
        if (!_definitionLoaded && !_definitionFetchFailed && exec.BatchDefinitionId is { Length: > 0 } defId)
        {
            await TryLoadDefinitionAsync(defId);
            await TryLoadRunAsync(defId);
        }

        var idx = _executionRows.FindIndex(r => r.ExecutionId == exec.ExecutionId);
        if (idx >= 0)
        {
            // Page-level monotonic guard — LiveExecutionRow's own guard does NOT cover this list,
            // and RebuildStatusMap reads row.Status. Reject stale/regressing status (Completed→Running).
            if (JobStatusRank.Rank(exec.Status) >= JobStatusRank.Rank(_executionRows[idx].Status))
                _executionRows[idx] = ExecutionRowViewModel.FromExecution(exec);
        }
        else
        {
            _executionRows.Add(ExecutionRowViewModel.FromExecution(exec));
        }
        // While a gate is pending, a successor's execution event is our cue that the gate may have been
        // decided (there is no "approval resolved" hub event). RefreshGatesAsync re-reads the gate feed and
        // rebuilds the map; otherwise just rebuild from rows. Skip the extra round-trip once no gate is pending.
        if (_pendingByStepId.Count > 0)
            await RefreshGatesAsync();
        else
            RebuildStatusMap();
        await _refresh!.RequestAsync();   // UiRefreshDebounce — coalesces bursts
    }

    private async Task OnApprovalRequestedAsync(PendingApproval approval)
    {
        if (approval.BatchId != BatchRunId) return;
        await RefreshGatesAsync();             // marks the gate AwaitingApproval ("waiting")
        await _refresh!.RequestAsync();
    }

    // Reconciles approval-gate node status from the gate feed (gates have no JobExecution row). Two reads
    // serve two purposes: ListBatchGatesAsync gives every gate's OWN recorded outcome (drives node COLOUR —
    // pending → AwaitingApproval, approved/auto-approved → Completed, any other terminal outcome → Failed);
    // ListApprovalsAsync gives the ACTIONABLE pending set (carries Config + ApprovalId, which the colouring
    // feed omits) so the inspector can approve/reject in place. Both reads are cheap; do NOT merge.
    private async Task RefreshGatesAsync()
    {
        if (_client is null) return;

        // Colouring feed — each gate carries its own outcome, so the overlay needs no batch-level inference.
        IReadOnlyList<ApprovalGateViewDto>? gates;
        try { gates = await _client.ListBatchGatesAsync(BatchRunId, CancellationToken.None); }
        catch (Exception) { gates = null; }   // gate endpoint hiccup — keep last known gate colours
        if (gates is { Count: > 0 })
            ApprovalGateReconciler.Apply(gates, _gateStatus);

        // Actionable feed — pending approvals for THIS run, keyed by step id, so the inspector can decide a
        // gate (and the in-node Approve button can appear). Last writer wins on the rare duplicate step id
        // (two gates on one step is a malformed definition). An endpoint hiccup keeps the last known set.
        try
        {
            var list = await _client.ListApprovalsAsync(null, CancellationToken.None);
            var byStep = new Dictionary<string, PendingApprovalDto>(StringComparer.Ordinal);
            foreach (var a in list ?? [])
            {
                if (a.BatchId != BatchRunId) continue;
                byStep[a.BatchStepId] = a;
            }
            _pendingByStepId = byStep;
        }
        catch (Exception) { /* keep last known actionable set */ }

        RebuildStatusMap();
    }

    private async Task TryLoadDefinitionAsync(string defId)
    {
        _definitionLoaded = true; // set BEFORE the await — re-entrancy guard (events fire 4× via fan-out)
        try
        {
            _definition = await _client!.GetBatchByIdAsync(defId, CancellationToken.None);
        }
        catch (Exception)
        {
            _definitionLoaded = false;       // un-pin so a subsequent retry is possible
            _definitionFetchFailed = true;   // bound retries (single attempt for this run)
        }
    }

    // Best-effort, single-shot fetch of THIS run's persisted row to read its forwarded state. Reuses the
    // run-store list (no single-run endpoint exists) filtered by definition id, then finds the run by id.
    // The single-shot + failed guards mirror the definition fetch so the up-to-4× hub fan-out does not
    // re-query on every event.
    private async Task TryLoadRunAsync(string defId)
    {
        if (_runLoaded || _runFetchFailed || _client is null) return;
        _runLoaded = true; // set BEFORE the await — re-entrancy guard (events fire 4× via fan-out)
        try
        {
            var runs = await _client.QueryRunsAsync(defId, includeRunning: true, 0, 50, CancellationToken.None);
            var run = runs?.Items.FirstOrDefault(r => string.Equals(r.BatchId, BatchRunId, StringComparison.Ordinal));
            if (run is null)
            {
                // Not on the first page of recent runs — leave the panel hidden rather than retry forever.
                _runFetchFailed = true;
                return;
            }
            if (run.ForwardedState is { Count: > 0 } state)
            {
                _forwardedInitialParameters = AsDictionary(state, ForwardedInitialParametersKey);
            }
        }
        catch (Exception)
        {
            _runLoaded = false;     // un-pin so a subsequent retry is possible
            _runFetchFailed = true; // bound retries (single attempt for this run)
        }
    }

    // Reads one reserved ForwardedState key as a dictionary. The value is itself a dictionary, but read back
    // from a JSON column it is a JsonElement (object), so normalise both shapes to a flat key/value map.
    private static IReadOnlyDictionary<string, object?>? AsDictionary(
        IReadOnlyDictionary<string, object?> state, string key)
    {
        if (!state.TryGetValue(key, out var raw) || raw is null) return null;
        switch (raw)
        {
            case IReadOnlyDictionary<string, object?> typed:
                return typed.Count > 0 ? typed : null;
            case System.Text.Json.JsonElement { ValueKind: System.Text.Json.JsonValueKind.Object } element:
                var map = new Dictionary<string, object?>(StringComparer.Ordinal);
                foreach (var prop in element.EnumerateObject())
                    map[prop.Name] = prop.Value;
                return map.Count > 0 ? map : null;
            default:
                return null;
        }
    }

    // Rebuild the full StepId→Status map from the authoritative row list on every event
    // (no per-node ref-counting — avoids desync on out-of-order / missed events).
    private void RebuildStatusMap()
    {
        var map = new Dictionary<string, JobStatus>(StringComparer.Ordinal);
        foreach (var row in _executionRows)
        {
            if (row.BatchStepId is { Length: > 0 } sid)
                map[sid] = row.Status;   // last writer wins; rows reflect page-level monotonic-guarded state
        }
        // Approval gates have no execution row — overlay their feed-derived status (RefreshGatesAsync).
        foreach (var (sid, st) in _gateStatus)
            map[sid] = st;
        _statusByStepId = map;
    }

    private async Task OnBatchCompletedAsync(BatchCompletionSummary summary)
    {
        if (summary.BatchId != BatchRunId) return;
        _completion = summary;
        await RefreshGatesAsync();   // final gate resolution — covers a TRAILING gate (no successor event)
        await _refresh!.RequestAsync();
    }

    private Task OnNodeSelectedAsync(BatchStep step)
    {
        // Selecting a different node clears any stale decision error/busy from the previous gate.
        _selectedStep = step;
        _selectedStepId = step.StepId;
        _decisionError = null;
        _decisionBusy = false;
        return Task.CompletedTask;
    }

    // One-click approve from the in-node Approve button. Select the gate FIRST (this opens
    // the inspector, which is the error surface — a 403/failure shows there with the gate already in view),
    // then run the EXISTING approve path. HandleApproveAsync reads SelectedPendingApprovalId(), which the
    // selection above just primed, so there is no separate approve code path: success → gate green + panel
    // read-only; failure → panel open showing DecisionError.
    private async Task HandleApproveFromNodeAsync(BatchStep step)
    {
        // Double-click safety: OnNodeSelectedAsync RESETS _decisionBusy (a fresh selection clears stale
        // state). If we re-selected on a second rapid click while the FIRST approve for this same gate is
        // still in flight, that reset would defeat HandleApproveAsync's own busy guard and double-submit.
        // So when we're already busy on the gate that's already selected, no-op the second click entirely.
        if (_decisionBusy && string.Equals(_selectedStepId, step.StepId, StringComparison.Ordinal)) return;
        await OnNodeSelectedAsync(step);
        await HandleApproveAsync();
    }

    private Task ClosePanel()
    {
        _selectedStep = null;
        _selectedStepId = null;
        _decisionError = null;
        _decisionBusy = false;
        return Task.CompletedTask;
    }

    // Render-only newest-first window over the whole stored list. The initial REST snapshot arrives
    // newest-first, but live hub events are appended to the END of _executionRows, so the stored order is
    // mixed. Normalise here at render time: order by enqueue time descending, with the execution id as the
    // tiebreak (UUIDv7 hex sorts by creation order within the same millisecond), then cap. _executionRows
    // itself is never reordered — RebuildStatusMap, gate reconciliation, and the completion roll-up read
    // the full list.
    private IEnumerable<ExecutionRowViewModel> RenderedRows()
        => _executionRows
            .OrderByDescending(r => r.EnqueuedAtUtc)
            .ThenByDescending(r => r.ExecutionId, StringComparer.Ordinal)
            .Take(MaxRenderedRows);

    // Deep link to the Executions query page pre-filtered to this run.
    private string AllExecutionsHref()
        => $"/dashboard/{ServiceName}/executions?batchId={Uri.EscapeDataString(BatchRunId)}";

    private JobStatus? SelectedStatus()
        => _selectedStepId is not null && _statusByStepId.TryGetValue(_selectedStepId, out var s) ? s : null;

    // Pending approval id for the selected step, or null — drives the inspector's decision UI.
    private string? SelectedPendingApprovalId()
        => _selectedStepId is not null && _pendingByStepId.TryGetValue(_selectedStepId, out var dto) ? dto.ApprovalId : null;

    // ── inline approve / reject ─────────────────────────────────────────────────────────
    // On success: re-list approvals (the gate falls out of pending → reconciler turns it green; the
    // successor step then streams in over the hub). On UKBatchClientException: map 403 → not-authorized,
    // anything else → a concise message; surface via _decisionError. Render via the debounce.

    private async Task HandleApproveAsync()
    {
        var approvalId = SelectedPendingApprovalId();
        if (_client is null || approvalId is null || _decisionBusy) return;

        _decisionBusy = true;
        _decisionError = null;
        await _refresh!.RequestAsync();
        try
        {
            await _client.ApproveAsync(approvalId, null, CancellationToken.None);
            await RefreshGatesAsync();
        }
        catch (UKBatchClientException ex)
        {
            _decisionError = DecisionErrorMessage(ex, "approve");
        }
        catch (Exception)
        {
            _decisionError = "Could not approve the gate. Please retry.";
        }
        finally
        {
            _decisionBusy = false;
            await _refresh!.RequestAsync();
        }
    }

    private async Task HandleRejectAsync(string reason)
    {
        var approvalId = SelectedPendingApprovalId();
        if (_client is null || approvalId is null || _decisionBusy) return;
        if (string.IsNullOrWhiteSpace(reason)) return;   // panel guards this too, but never trust the caller

        _decisionBusy = true;
        _decisionError = null;
        await _refresh!.RequestAsync();
        try
        {
            await _client.RejectAsync(approvalId, reason, CancellationToken.None);
            await RefreshGatesAsync();
        }
        catch (UKBatchClientException ex)
        {
            _decisionError = DecisionErrorMessage(ex, "reject");
        }
        catch (Exception)
        {
            _decisionError = "Could not reject the gate. Please retry.";
        }
        finally
        {
            _decisionBusy = false;
            await _refresh!.RequestAsync();
        }
    }

    private static string DecisionErrorMessage(UKBatchClientException ex, string verb)
        => ex.StatusCode == System.Net.HttpStatusCode.Forbidden
            ? "Not authorized to decide this gate (role mismatch)."
            : $"Could not {verb} the gate: {ex.Message}";

    // Administrative run cancel. The request is idempotent server-side; we do NOT optimistically paint
    // Cancelled — the authoritative terminal status arrives over the BatchCompleted hub feed (the run
    // continues asynchronously, and a job already dispatched may finish anyway). On request failure surface a
    // banner; the button stays available for a retry while the run is still in flight.
    private async Task ConfirmCancelAsync()
    {
        _confirmCancelOpen = false;
        if (_client is null || _cancelInFlight) return;
        _cancelInFlight = true;
        _cancelError = null;
        await _refresh!.RequestAsync();
        try
        {
            await _client.CancelRunAsync(BatchRunId, CancellationToken.None);
        }
        catch (UKBatchClientException ex)
        {
            _cancelError = $"Could not cancel the run: {ex.Message}";
        }
        catch (Exception)
        {
            _cancelError = "Could not cancel the run. Please retry.";
        }
        finally
        {
            _cancelInFlight = false;
            await _refresh!.RequestAsync();
        }
    }

    private static string CompletionBgClass(JobStatus status) => status switch
    {
        JobStatus.Completed => "batch-run__completion--completed",
        JobStatus.Failed => "batch-run__completion--failed",
        JobStatus.Cancelled => "batch-run__completion--cancelled",
        _ => string.Empty,
    };

    // Status-aware verb for the completion banner so a gate-failed run reads "X failed", not "X completed".
    // The shard counts below stay JOB-level (a gate is not a job); the verb + badge convey the run outcome.
    private static string CompletionVerb(JobStatus status) => status switch
    {
        JobStatus.Failed => "failed",
        JobStatus.Cancelled => "cancelled",
        _ => "completed",
    };

    public async ValueTask DisposeAsync()
    {
        if (_client is not null)
        {
            _client.ExecutionStateChanged -= OnExecutionStateChangedAsync;
            _client.BatchCompleted -= OnBatchCompletedAsync;
            _client.ApprovalRequested -= OnApprovalRequestedAsync;
            if (_subscribed)
            {
                try { await _client.UnsubscribeFromBatchAsync(BatchRunId, CancellationToken.None); }
                catch (Exception) { /* ignore */ }
            }
        }
        if (_refresh is not null) await _refresh.DisposeAsync();
    }
}

