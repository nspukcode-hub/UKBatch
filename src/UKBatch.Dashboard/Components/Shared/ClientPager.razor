@* Render-only pager for an already-fetched, in-memory list. Unlike PageEnvelopePager (which
   drives server offset paging over PageEnvelope<T>), this pages a slice the parent has fully
   loaded: it owns no data, only the current page index. Live pages whose full row list is read by
   other logic (status maps, completion roll-ups) keep paging the RENDER only — the data stays whole. *@

<div class="page-envelope-pager">
    <div class="page-envelope-pager__summary">
        @if (TotalCount > 0)
        {
            <span>Showing @(FirstItemNumber)–@(LastItemNumber) of @TotalCount</span>
        }
        else
        {
            <span>—</span>
        }
    </div>
    <div class="page-envelope-pager__controls">
        <button class="btn btn--ghost btn--sm" @onclick="GoFirst" disabled="@(!CanGoBack)" aria-label="First page">
            <span class="material-symbols-outlined">first_page</span>
        </button>
        <button class="btn btn--ghost btn--sm" @onclick="GoPrev" disabled="@(!CanGoBack)" aria-label="Previous page">
            <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <span class="page-envelope-pager__page-indicator">
            Page @(PageIndex + 1) of @TotalPages
        </span>
        <button class="btn btn--ghost btn--sm" @onclick="GoNext" disabled="@(!CanGoForward)" aria-label="Next page">
            <span class="material-symbols-outlined">chevron_right</span>
        </button>
        <button class="btn btn--ghost btn--sm" @onclick="GoLast" disabled="@(!CanGoForward)" aria-label="Last page">
            <span class="material-symbols-outlined">last_page</span>
        </button>
    </div>
</div>

@code {
    /// <summary>
    /// Shared page size for every client-side paged list — the single source of truth.
    /// 30 compact rows fit a desktop screen, so the operator flips pages less often.
    /// </summary>
    public const int DefaultPageSize = 30;

    /// <summary>Total number of items in the parent's full (un-paged) list.</summary>
    [Parameter, EditorRequired] public int TotalCount { get; set; }

    /// <summary>Zero-based index of the page the parent is currently rendering.</summary>
    [Parameter, EditorRequired] public int PageIndex { get; set; }

    /// <summary>Items per page. Defaults to <see cref="DefaultPageSize"/>.</summary>
    [Parameter] public int PageSize { get; set; } = DefaultPageSize;

    /// <summary>Raised with the requested zero-based page index when the operator navigates.</summary>
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private int EffectivePageSize => PageSize > 0 ? PageSize : DefaultPageSize;

    private int TotalPages => TotalCount > 0
        ? (TotalCount + EffectivePageSize - 1) / EffectivePageSize
        : 1;

    private int FirstItemNumber => (PageIndex * EffectivePageSize) + 1;

    private int LastItemNumber => Math.Min((PageIndex + 1) * EffectivePageSize, TotalCount);

    private bool CanGoBack => PageIndex > 0;

    private bool CanGoForward => PageIndex < TotalPages - 1;

    private Task GoFirst() => CanGoBack ? OnPageChanged.InvokeAsync(0) : Task.CompletedTask;

    private Task GoPrev() => CanGoBack ? OnPageChanged.InvokeAsync(PageIndex - 1) : Task.CompletedTask;

    private Task GoNext() => CanGoForward ? OnPageChanged.InvokeAsync(PageIndex + 1) : Task.CompletedTask;

    private Task GoLast() => CanGoForward ? OnPageChanged.InvokeAsync(TotalPages - 1) : Task.CompletedTask;
}
