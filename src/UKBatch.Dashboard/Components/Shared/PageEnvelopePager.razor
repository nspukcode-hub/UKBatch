@* Generic pagination footer for PageEnvelope<T> consumers. *@
@typeparam T

<div class="page-envelope-pager">
    <div class="page-envelope-pager__summary">
        @if (Envelope is { } env && env.TotalCount > 0)
        {
            <span>Showing @(env.Offset + 1)–@(Math.Min(env.Offset + env.Items.Count, env.TotalCount)) of @env.TotalCount</span>
        }
        else
        {
            <span>—</span>
        }
    </div>
    <div class="page-envelope-pager__controls">
        <button class="btn btn--ghost btn--sm" @onclick="GoFirst" disabled="@(!CanGoBack())" aria-label="First page">
            <span class="material-symbols-outlined">first_page</span>
        </button>
        <button class="btn btn--ghost btn--sm" @onclick="GoPrev" disabled="@(!CanGoBack())" aria-label="Previous page">
            <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <span class="page-envelope-pager__page-indicator">
            Page @CurrentPage of @TotalPages
        </span>
        <button class="btn btn--ghost btn--sm" @onclick="GoNext" disabled="@(!CanGoForward())" aria-label="Next page">
            <span class="material-symbols-outlined">chevron_right</span>
        </button>
        <button class="btn btn--ghost btn--sm" @onclick="GoLast" disabled="@(!CanGoForward())" aria-label="Last page">
            <span class="material-symbols-outlined">last_page</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public PageEnvelope<T>? Envelope { get; set; }
    [Parameter] public int Limit { get; set; } = 50;
    [Parameter] public EventCallback<int> OnOffsetChanged { get; set; }

    private long Total => Envelope?.TotalCount ?? 0;
    private int Offset => Envelope?.Offset ?? 0;

    private long TotalPages => Limit > 0 && Total > 0
        ? (Total + Limit - 1) / Limit
        : 1;

    private long CurrentPage => Limit > 0 ? (Offset / Limit) + 1 : 1;

    private bool CanGoBack() => Offset > 0;
    private bool CanGoForward() => Envelope is { } env && (env.Offset + env.Items.Count) < env.TotalCount;

    private Task GoFirst() => OnOffsetChanged.InvokeAsync(0);
    private Task GoPrev() => OnOffsetChanged.InvokeAsync(Math.Max(0, Offset - Limit));
    private Task GoNext() => OnOffsetChanged.InvokeAsync(Offset + Limit);
    private Task GoLast()
    {
        if (Envelope is not { } env || Limit <= 0) return Task.CompletedTask;
        var lastOffset = (int)((env.TotalCount - 1) / Limit) * Limit;
        return OnOffsetChanged.InvokeAsync(Math.Max(0, lastOffset));
    }
}
