@* Empty list / not-found placeholder. *@

<div class="empty-state" role="status">
    <span class="material-symbols-outlined empty-state__icon">@IconName</span>
    <h2 class="empty-state__title">@Title</h2>
    @if (!string.IsNullOrEmpty(Detail))
    {
        <p class="empty-state__detail">@Detail</p>
    }
    @if (ActionContent is not null)
    {
        <div class="empty-state__action">@ActionContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string IconName { get; set; } = "inbox";
    [Parameter] public RenderFragment? ActionContent { get; set; }
}
