<Project>
  <PropertyGroup>
    <!-- UKBatch.Dashboard's App.razor + Routes.razor + Pages live INSIDE this library, not in the
         host project. The Web SDK's auto-detection of Razor Components framework assets
         (Microsoft.NET.Sdk.Web.ProjectSystem.targets:32) looks for `.razor` Content items in the
         HOST project — which has none — and decides the host doesn't need them. The result:
         `_framework/blazor.web.js` silently absent from the static-web-assets manifest, and
         Blazor interactivity (button clicks, SignalR circuit, live updates) fails with a 404 that
         only browser DevTools surfaces. Setting RequiresAspNetWebAssets explicitly is the SDK's
         supported escape hatch — see Microsoft.NET.Sdk.FrameworkReferenceResolution.targets:21 for
         the default-false fallback. Consumer can override by setting the prop themselves before
         this file evaluates. -->
    <RequiresAspNetWebAssets Condition="'$(RequiresAspNetWebAssets)' == ''">true</RequiresAspNetWebAssets>
  </PropertyGroup>
</Project>
