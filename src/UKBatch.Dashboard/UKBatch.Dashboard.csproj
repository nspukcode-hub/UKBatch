<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>Blazor Server centralized dashboard for UKBatch services — monitoring, triggering, approvals, and a visual batch editor. Multi-service via IUKBatchServiceRegistry; subscribes to REST + SignalR endpoints exposed by UKBatch.Api.</Description>
    <RootNamespace>UKBatch.Dashboard</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Razor Components + Interactive Server. -->
    <StaticWebAssetBasePath>_content/UKBatch.Dashboard</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- Microsoft.Extensions.Http.Polly is intentionally NOT referenced. v0.1 ships without
         REST client-side retry. v0.2 may add Microsoft.Extensions.Http.Resilience (Polly v8
         API was incompatible with the central package management snapshot — no PackageVersion
         entry in Directory.Packages.props for Microsoft.Extensions.Http.Polly). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UKBatch.Api\UKBatch.Api.csproj" />
    <!-- Transitively brings: UKBatch.AspNetCore + UKBatch.Core + UKBatch.Abstractions -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UKBatch.Dashboard.Tests" />
  </ItemGroup>

  <!-- Override the repo-root README pack from Directory.Build.props with the per-package README. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- A .NET 10 host that consumes this package as a NuGet library and runs the dashboard MUST set
       <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets> in its own project. The .NET Web SDK only
       emits the Razor Components framework assets (blazor.web.js) when it detects the host as a Razor
       host, which it is not when App.razor lives inside this package. That property is consumed during
       NuGet restore, before a package's build assets are imported, so a package cannot supply it
       automatically — only the consuming project (or its Directory.Build.props) can. Without it
       _framework/blazor.web.js returns 404 at runtime and dashboard interactivity silently fails.
       The .targets below turns that silent runtime 404 into a build-time warning on .NET 10 when the
       property is missing. (.NET 8 hosts do not need it — MapRazorComponents serves the assets there.) -->
  <ItemGroup>
    <!-- buildTransitive/ alone reaches both direct and indirect consumers; packing into build/ too
         would import the target twice and emit the warning twice. -->
    <None Include="build/UKBatch.Dashboard.targets" Pack="true"
          PackagePath="buildTransitive/UKBatch.Dashboard.targets" />
  </ItemGroup>

</Project>
