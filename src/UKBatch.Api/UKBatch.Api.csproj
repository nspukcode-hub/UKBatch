<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>REST API + OpenAPI 3.1 schema + SignalR push hub for UKBatch. Mounts under any RouteGroupBuilder via MapUKBatchApi. Auth-agnostic — call RequireAuthorization to opt in.</Description>
    <RootNamespace>UKBatch.Api</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\UKBatch.Core\UKBatch.Core.csproj" />
    <ProjectReference Include="..\UKBatch.AspNetCore\UKBatch.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in OpenAPI document generation (AddOpenApi + document/schema transformers) requires
         net9+. The net8.0 build ships the full REST + SignalR surface without the /openapi/v1.json
         document; consumers who need one on net8 can layer Swashbuckle over the mapped endpoints. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <!-- SignalR is part of the framework ref; do NOT add Microsoft.AspNetCore.SignalR PackageReference (NU1510). -->

  <ItemGroup>
    <InternalsVisibleTo Include="UKBatch.Api.Tests" />
  </ItemGroup>

  <!-- Override the repo-root README pack from Directory.Build.props with the per-project README.
       Mirrors the pattern in UKBatch.AspNetCore.csproj. Without this, the root README.md (generic UKBatch
       elevator pitch) is packed instead of the Api-specific README (REST surface + SignalR contract). -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
