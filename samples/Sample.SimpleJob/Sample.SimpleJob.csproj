<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sample.SimpleJob</RootNamespace>
    <UserSecretsId>sample-simplejob-c19b6d54</UserSecretsId>
    <!-- IDE0005 (unused usings) is only enforced on build when doc generation is enabled. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sample apps don't need to enforce xmldoc-on-everything; suppress missing-xmldoc warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UKBatch.AspNetCore\UKBatch.AspNetCore.csproj" />
  </ItemGroup>

</Project>
