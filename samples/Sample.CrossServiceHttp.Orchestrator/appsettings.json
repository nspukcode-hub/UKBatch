{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UKBatch": {
    "ThisServiceName": "orchestrator",
    "Transport": {
      "Http": {
        "SharedSecret": "DEV-SECRET-NOT-FOR-PRODUCTION-32B-FILLER-ABCDEF",
        "DefaultRequestTimeout": "00:00:30",
        "LongPollMaxWait": "00:00:25",
        "MaxClockSkew": "00:05:00",
        "Services": {
          "billing-worker": {
            "BaseUrl": "http://localhost:5150"
          }
        }
      }
    }
  },
  "Dashboard": {
    "Services": [
      {
        "Name": "local",
        "DisplayName": "Local Orchestrator",
        "BaseUrl": "http://localhost:5050/api/"
      }
    ],
    "DefaultServiceName": "local"
  }
}
