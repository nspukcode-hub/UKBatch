<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions (runtime + DI + hosting)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core (framework refs typically, not packages)">
    <!-- ASP.NET Core package versions track the runtime major per TFM: the 10.0.x line ships no
         net8.0 assets, so net8.0 inner builds resolve the 8.0.x (LTS) line instead. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <!-- OpenID Connect + JWT bearer handlers are NOT in the shared framework (unlike Cookies), so they
         are real package references in UKBatch.AspNetCore.OpenIdConnect. Versions track the runtime
         major per TFM: the 10.0.x line ships no net8.0 assets, so net8.0 resolves the 8.0.x (LTS) line. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <!-- Built-in OpenAPI document generation requires net9+. The net8.0 build omits the package
         reference entirely (see UKBatch.Api.csproj), so a single version suffices here. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Transitive pin (CentralPackageTransitivePinningEnabled): Microsoft.AspNetCore.OpenApi 10.0.0
         pulls Microsoft.OpenApi 2.0.0, which carries NU1903 advisory GHSA-v5pm-xwqc-g5wc (circular
         schema references may terminate parsing; the 2.x line is patched in 2.7.5). Pin forward to
         clear the audit under TreatWarningsAsErrors. The net8.0 build never references the OpenAPI
         packages, so this entry is simply unused there. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup Label="Threading and runtime">
    <PackageVersion Include="System.Threading.Channels" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Scheduling + resilience">
    <PackageVersion Include="Cronos" Version="0.10.0" />
    <PackageVersion Include="Polly" Version="8.5.0" />
    <PackageVersion Include="Polly.Extensions" Version="8.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Storage adapters">
    <!-- EF Core tracks the runtime major per TFM: EF Core 10 targets net10.0 only, so net8.0
         inner builds resolve the EF Core 8 (LTS) line. The migration set is shared — it uses
         only ModelBuilder/MigrationBuilder APIs present in both majors. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <!-- Transitive pin (CentralPackageTransitivePinningEnabled): Microsoft.EntityFrameworkCore.Design
         (build-time only, PrivateAssets="all") pulls System.Security.Cryptography.Xml 9.0.0 via
         Microsoft.Build.Tasks.Core / Microsoft.CodeAnalysis.Workspaces.MSBuild, which carries
         NU1903 advisories GHSA-37gx-xxp4-5rgx + GHSA-w3x6-4m5h-cxqf (10.x line patched in 10.0.6).
         Pin forward to clear the audit under TreatWarningsAsErrors. Design-time only — ships nothing
         to consumers. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.6" Condition="'$(TargetFramework)' != 'net8.0'" />
    <!-- net8.0: the EF Core 8 Design graph pulls the 8.0.x line; both advisories above are
         patched in 8.0.2 on that line. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup Label="Transport adapters">
    <PackageVersion Include="RabbitMQ.Client" Version="7.0.0" />
    <PackageVersion Include="Confluent.Kafka" Version="2.6.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.18.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.0" />
    <!-- Pin to 7.0.0 and DO NOT upgrade to 8.x. FluentAssertions 8+ moved to the Xceed Community
         License, which requires a paid license for commercial use. Version 7 stays Apache-2.0
         indefinitely and still receives bugfixes; this is a test-only dependency that is never
         shipped. If a future .NET target ever needs a newer assertion library, AwesomeAssertions is
         a drop-in Apache-2.0 fork of v7 (package + namespace rename). -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="bunit" Version="1.34.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Source-link + build">
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

</Project>
